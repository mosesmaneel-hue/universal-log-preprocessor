# ============================================================
# Universal Log Preprocessor - Environment Configuration
# ============================================================

# Environment: "development" or "production"
APP_ENV=production

# Database Path override (Optional - defaults to backend/logs_production.db)
# On Render with Persistent Disk, set to: /var/data/logs_production.db
LOGS_DB_PATH=

# Allowed CORS Origins (Comma-separated, for Vercel production frontend)
# Example: https://universal-log-preprocessor.vercel.app
ALLOWED_ORIGINS=

# AI Provider Mode: "ollama" (local dev) or "api" (production platform)
AI_PROVIDER=api
AI_MODEL=gpt-4o-mini
OLLAMA_ENDPOINT=http://127.0.0.1:11434

# Platform AI Settings (Production)
AI_API_ENDPOINT=https://api.openai.com/v1/chat/completions
AI_API_KEY=

# General AI Settings
AI_REQUEST_TIMEOUT_SECONDS=75
